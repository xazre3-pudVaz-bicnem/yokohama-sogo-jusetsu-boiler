# 給湯器専門サイトの環境変数の見本。
# このファイルを .env.local にコピーして値を入れる（.env.local は Git に入らない）。
# 本番では、Vercel のプロジェクト「Settings → Environment Variables」に入れる。
# コーポレートサイト（www.yokohama-sogo-jusetsu.com）の Vercel プロジェクトとは別に管理し、値を共有しないこと。
# API キーやメールアドレスを、このファイルや README に書いて Git に入れないこと。

# ── 公開 URL ──────────────────────────────────────────────
# 本番のドメインが決まったら、Vercel の「Production」にだけ入れる（Preview には入れない）。
# 未設定のあいだは、全ページが noindex になり、canonical・sitemap・OGP の URL は出ない。
NEXT_PUBLIC_SITE_URL=

# ── お見積もりフォーム（Resend でメールを送る） ─────────────
# 2つとも入っているときだけ、フォームが送信できる（本番で未設定なら、フォームを出さずに電話・LINE を案内する）。
RESEND_API_KEY=
# 受け取るアドレス。複数ならカンマ区切り
CONTACT_TO_EMAIL=
# 送信元。Resend で認証したドメインのアドレス（空ならコーポレートサイトのドメインの noreply@ を使う）
CONTACT_FROM_EMAIL=
# 1 にすると、お客様にも受付の控えのメールを送る
CONTACT_AUTOREPLY=

# ── 写真でかんたん見積もり：写真から型番を読み取る（任意） ─────────────
# Vercel に、このサイト用の Claude の API キーを入れると、「写真から型番を読み取る」ボタンが出る。
# コラムの自動投稿の GitHub の Secret とは別に、Vercel の環境変数として入れる（値は同じキーでも、別のキーでもよい）。
# 読み取りのモデル（空なら claude-haiku-5-5）。止めたいときは LABEL_READER=off
# ANTHROPIC_API_KEY=
LABEL_READER_MODEL=
LABEL_READER=

# ── コラムの自動投稿（GitHub Actions の Secrets / Variables に入れる。手元で試すときだけここに） ──
ANTHROPIC_API_KEY=
# 書くモデル・読み直すモデル（空なら claude-haiku-5-5）。品質の検査に通らない日が続くときは、
# 読み直しだけ上のモデル（claude-sonnet-5-5 など）にすると、通る記事が増える
ANTHROPIC_MODEL=
ANTHROPIC_REVIEW_MODEL=

# ── 検索エンジンの所有権の確認（値があるときだけ meta を出す） ──
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
